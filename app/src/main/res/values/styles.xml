<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CalcButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/calc_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/calc_key</item>
        <item name="rippleColor">@color/calc_ripple</item>
        <item name="strokeWidth">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="CalcMemory" parent="CalcButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/calc_muted</item>
        <item name="backgroundTint">@color/calc_background</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="CalcOperation" parent="CalcButton">
        <item name="backgroundTint">@color/calc_operator</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="CalcUtility" parent="CalcButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/calc_muted</item>
    </style>

    <style name="CalcAction" parent="CalcButton">
        <item name="android:textColor">@color/calc_muted</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="CalcEqual" parent="CalcButton">
        <item name="backgroundTint">@color/calc_accent</item>
        <item name="android:textColor">@color/calc_background</item>
        <item name="android:textSize">34sp</item>
    </style>
</resources>
